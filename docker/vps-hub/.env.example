# Headroom VPS Hub runtime
# Use this file as a template for Dokploy environment variables.
# Do not commit a real .env file with secrets.

# Container image. Keep latest for quick MVP, pin a version later for production.
HEADROOM_IMAGE=ghcr.io/chopratejas/headroom:latest

# Proxy bind settings inside the container.
HEADROOM_HOST=0.0.0.0
HEADROOM_PORT=8787

# Persistent state path inside the container. docker-compose.yml mounts a named
# volume here for metrics, CCR state, logs, and future memory data.
HEADROOM_WORKSPACE_DIR=/data/headroom

# Fail startup if the Rust core extension is missing. Safer than silently
# running a degraded Python-only proxy.
HEADROOM_REQUIRE_RUST_CORE=true

# Disable upstream telemetry for a private VPS deployment.
HEADROOM_TELEMETRY=off

# 9Router OpenAI-compatible upstream.
# Replace with your real 9Router /v1 base URL in Dokploy.
OPENAI_TARGET_API_URL=https://your-9router.example.com/v1

# Replace with your real 9Router-issued key in Dokploy.
OPENAI_API_KEY=replace-with-9router-key

# Optional provider keys. Leave blank unless your 9Router path or a specific
# provider route requires them.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional observability endpoint. Leave blank for MVP.
OTEL_EXPORTER_OTLP_ENDPOINT=
